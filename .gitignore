# Ignore object files and compiled binaries
*.o
*.out
*.exe

# Ignore build directories typically used by cmake or make
/build/
/bin/
/obj/
/Debug/
/Release/

# Ignore cmake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# Ignore temporary files generated by editors or IDEs
*.swp
*.swo
*.bak
*~
*.tmp
*.log
*_backup

# Ignore macOS specific files
.DS_Store

# Ignore Windows specific files
Thumbs.db
desktop.ini
